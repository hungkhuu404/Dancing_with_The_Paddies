{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "series",
  "$comment": "Implements data contract 2.0.0 (docs/data-contract.md).",
  "type": "object",
  "properties": {
    "cells": {
      "type": "object",
      "patternProperties": {
        "^E\\d+N\\d+$": {
          "type": "object",
          "properties": {
            "s": {
              "type": "string",
              "pattern": "^[WN-]*$"
            },
            "s_raw": {
              "type": "string",
              "pattern": "^[WN-]*$"
            },
            "hh": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "integer",
                    "not": {
                      "const": -9999
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "minItems": 0
            },
            "hv": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "integer",
                    "not": {
                      "const": -9999
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "minItems": 0
            }
          },
          "required": [
            "s",
            "s_raw",
            "hh",
            "hv"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "cells"
  ]
}
