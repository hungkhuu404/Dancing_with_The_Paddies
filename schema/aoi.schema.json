{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aoi",
  "$comment": "Implements CONTRACT-001 1.0.0 in docs/data-contract.md.",
  "type": "object",
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "Feature"
          },
          "geometry": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "Polygon"
                  },
                  "coordinates": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          },
                          {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "minItems": 4
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "MultiPolygon"
                  },
                  "coordinates": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": -180,
                              "maximum": 180
                            },
                            {
                              "type": "number",
                              "minimum": -90,
                              "maximum": 90
                            }
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "minItems": 4
                      },
                      "minItems": 1
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ]
              }
            ]
          },
          "properties": {
            "type": "object",
            "properties": {
              "site": {
                "enum": [
                  "tan_hoi",
                  "bang_rakam"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "osm_relation": {
                "type": "integer",
                "minimum": 1
              },
              "area_ha": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "site",
              "name",
              "osm_relation",
              "area_ha"
            ]
          }
        },
        "required": [
          "type",
          "geometry",
          "properties"
        ]
      },
      "minItems": 1,
      "maxItems": 1
    }
  },
  "required": [
    "type",
    "features"
  ]
}
