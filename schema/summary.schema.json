{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "summary",
  "$comment": "Implements CONTRACT-001 2.0.0 in docs/data-contract.md.",
  "type": "object",
  "properties": {
    "passes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "i": {
            "type": "integer",
            "minimum": 0
          },
          "date_local": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "track": {
            "type": "string",
            "pattern": "^\\d{3}[AD]$"
          },
          "valid_ha": {
            "type": "number",
            "minimum": 0
          },
          "water_ha": {
            "type": "number",
            "minimum": 0
          },
          "new_water_ha": {
            "type": "number",
            "minimum": 0
          },
          "water_gone_ha": {
            "type": "number",
            "minimum": 0
          },
          "asof_obs_ha": {
            "type": "number",
            "minimum": 0
          },
          "asof_water_ha": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "i",
          "date_local",
          "track",
          "valid_ha",
          "water_ha",
          "new_water_ha",
          "water_gone_ha",
          "asof_obs_ha",
          "asof_water_ha"
        ]
      },
      "minItems": 0
    },
    "totals": {
      "type": "object",
      "properties": {
        "n_cells": {
          "type": "integer",
          "minimum": 0
        },
        "area_ha": {
          "type": "number",
          "minimum": 0
        },
        "last_obs_local": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status_ha": {
          "type": "object",
          "properties": {
            "never_water": {
              "type": "number",
              "minimum": 0
            },
            "flooded": {
              "type": "number",
              "minimum": 0
            },
            "water_gone": {
              "type": "number",
              "minimum": 0
            },
            "always_water": {
              "type": "number",
              "minimum": 0
            },
            "no_data": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "never_water",
            "flooded",
            "water_gone",
            "always_water",
            "no_data"
          ]
        },
        "gt30_ha": {
          "type": "object",
          "properties": {
            "yes": {
              "type": "number",
              "minimum": 0
            },
            "possible": {
              "type": "number",
              "minimum": 0
            },
            "no": {
              "type": "number",
              "minimum": 0
            },
            "na": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "yes",
            "possible",
            "no",
            "na"
          ]
        }
      },
      "required": [
        "n_cells",
        "area_ha",
        "last_obs_local",
        "status_ha",
        "gt30_ha"
      ]
    }
  },
  "required": [
    "passes",
    "totals"
  ]
}
