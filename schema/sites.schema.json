{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sites",
  "$comment": "Implements CONTRACT-001 1.0.0 in docs/data-contract.md.",
  "type": "object",
  "properties": {
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "tan_hoi",
              "bang_rakam"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "epsg": {
            "enum": [
              32648,
              32647
            ]
          },
          "center": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "bounds": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "minItems": 4,
            "maxItems": 4,
            "items": false
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "region",
          "epsg",
          "center",
          "bounds",
          "default"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "sites"
  ]
}
