{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "places",
  "$comment": "Implements data contract 2.0.0 (docs/data-contract.md).",
  "type": "object",
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "Feature"
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "const": "Point"
              },
              "coordinates": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "type",
              "coordinates"
            ]
          },
          "properties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "osm_id": {
                "type": "string",
                "pattern": "^node/\\d+$"
              }
            },
            "required": [
              "name",
              "osm_id"
            ]
          }
        },
        "required": [
          "type",
          "geometry",
          "properties"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "type",
    "features"
  ]
}
